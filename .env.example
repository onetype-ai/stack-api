# Copy to .env, which `pnpm dev` and `pnpm start` read and git ignores.
# Values here are development defaults, never secrets.

PORT=7280
DATABASE_FILE=./data/app.db
# Postgres instead: DATABASE_URL=postgres://user@localhost/app (then DATABASE_FILE is not read).
ORIGINS=http://localhost:7380
LOG_LEVEL=info

# A plugin's config is <PLUGIN>__<FIELD>: plugin "web-crawler", field
# "baseURL" reads WEB_CRAWLER__BASE_URL. A variable no field reads stops the boot.
